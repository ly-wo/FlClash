+func (c *Client) authentication(now uint64) []byte {
+	if len(c.shanlianUID) != 16 {
+		return c.passwordSha256
+	}
+	auth := make([]byte, 32)
+	copy(auth, c.shanlianUID)
+	clock := make([]byte, 16)
+	binary.BigEndian.PutUint64(clock[:8], c.startedAt*10+3)
+	binary.BigEndian.PutUint64(clock[8:], now)
+	for i := range c.shanlianUID {
+		auth[16+i] = c.shanlianUID[i] ^ clock[i]
+	}
+	return auth
+}
