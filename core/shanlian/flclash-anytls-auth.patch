diff --git a/transport/anytls/client_shanlian_test.go b/transport/anytls/client_shanlian_test.go
new file mode 100644
index 00000000..b5b05705
--- /dev/null
+++ b/transport/anytls/client_shanlian_test.go
@@ -0,0 +1,30 @@
+package anytls
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"testing"
+)
+
+func TestAuthenticationDefaultsToStandardPasswordHash(t *testing.T) {
+	want := sha256.Sum256([]byte("secret"))
+	client := &Client{passwordSha256: want[:]}
+	if got := client.authentication(200); !bytes.Equal(got, want[:]) {
+		t.Fatalf("standard AnyTLS authentication changed: %x", got)
+	}
+}
+
+func TestAuthenticationUsesShanlianUIDAndClockWhenConfigured(t *testing.T) {
+	uid := bytes.Repeat([]byte{0x23}, 16)
+	client := &Client{passwordSha256: bytes.Repeat([]byte{0xff}, 32), shanlianUID: uid, startedAt: 100}
+	got := client.authentication(200)
+	if !bytes.Equal(got[:16], uid) {
+		t.Fatalf("uid prefix mismatch: %x", got[:16])
+	}
+	wantClock := []byte{0, 0, 0, 0, 0, 0, 3, 235, 0, 0, 0, 0, 0, 0, 0, 200}
+	for i := range uid {
+		if got[16+i]^uid[i] != wantClock[i] {
+			t.Fatalf("clock byte %d mismatch: %x", i, got[16+i]^uid[i])
+		}
+	}
+}
