@@ -0,0 +1,72 @@
+package adapter
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestParseAnyTLSWithShanlianUIDAndNoPassword(t *testing.T) {
+	proxy, err := ParseProxy(map[string]any{
+		"name":         "node",
+		"type":         "anytls",
+		"server":       "127.0.0.1",
+		"port":         443,
+		"shanlian-uid": "0123456789abcdef0123456789ABCDEF",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer proxy.Close()
+	if proxy.Name() != "node" {
+		t.Fatalf("name = %s", proxy.Name())
+	}
+	if proxy.Type().String() != "AnyTLS" {
+		t.Fatalf("type = %s", proxy.Type().String())
+	}
+}
+
+func TestParseAnyTLSWithPasswordKeepsStandardProxy(t *testing.T) {
+	proxy, err := ParseProxy(map[string]any{
+		"name":     "plain",
+		"type":     "anytls",
+		"server":   "127.0.0.1",
+		"port":     443,
+		"password": "secret",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer proxy.Close()
+	if proxy.Name() != "plain" {
+		t.Fatalf("name = %s", proxy.Name())
+	}
+}
+
+func TestParseAnyTLSRejectsInvalidShanlianUID(t *testing.T) {
+	_, err := ParseProxy(map[string]any{
+		"name":         "node",
+		"type":         "anytls",
+		"server":       "127.0.0.1",
+		"port":         443,
+		"password":     "secret",
+		"shanlian-uid": "not-a-valid-uid-value",
+	})
+	if err == nil || !strings.Contains(err.Error(), "invalid shanlian-uid: expected 32 hexadecimal characters") {
+		t.Fatalf("error = %v", err)
+	}
+	if err != nil && (strings.Contains(err.Error(), "secret") || strings.Contains(err.Error(), "not-a-valid-uid-value")) {
+		t.Fatal("invalid uid error leaked authentication material")
+	}
+}
+
+func TestParseAnyTLSRejectsMissingPasswordAndUID(t *testing.T) {
+	_, err := ParseProxy(map[string]any{
+		"name":   "node",
+		"type":   "anytls",
+		"server": "127.0.0.1",
+		"port":   443,
+	})
+	if err == nil || !strings.Contains(err.Error(), "missing password") {
+		t.Fatalf("error = %v", err)
+	}
+}
